{
  "name": "juntadin",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --filter @juntadin/mobile start",
    "dev:web": "pnpm --filter @juntadin/mobile web",
    "supabase:start": "supabase start",
