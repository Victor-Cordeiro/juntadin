{
  "expo": {
    "name": "JuntaDin",
    "slug": "juntadin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "juntadin",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.juntadin.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B5F4C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "package": "com.juntadin.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "O JuntaDin precisa acessar suas fotos para você escolher uma foto de perfil. Ela fica salva apenas neste aparelho.",
          "cameraPermission": "O JuntaDin usa a câmera quando você decide fotografar um recibo. A imagem é enviada com segurança ao Google Cloud para extrair o lançamento e não é adicionada à sua conta."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "O JuntaDin usa o microfone quando você decide ditar um lançamento. O áudio é enviado com segurança ao Google Cloud para extrair os dados e não é adicionado à sua conta."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#06372C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3568f110-74db-440b-94b9-00b14fef8179"
      }
    },
    "owner": "appcordeiro"
  }
}
